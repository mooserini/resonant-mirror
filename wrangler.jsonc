{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resonant-mirror-portfolio",
  "account_id": "815bcdaf788850798df37ed8f3afb8d0",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.getadongle.com/*",
      "zone_id": "4e2ee5bb4dee2ff2ddcced14e2e0d5e9"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "services": [
    {
      "binding": "RED_DOOR",
      "service": "red-door"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "REFINEMENTS_DB",
      "database_name": "portfolio-refinements",
      "database_id": "86d43caa-b7a1-4cb3-8073-1bda7aaf2a0b",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "https://www.getadongle.com",
    "AUTH_RP_ID": "www.getadongle.com",
    "FIREBASE_PROJECT_ID": "gen-lang-client-0304120170"
  }
}
